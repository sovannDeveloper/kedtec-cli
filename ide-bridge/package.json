{
  "name": "kedtec-ide-bridge",
  "displayName": "KEDTec",
  "description": "KEDTec coding agent chat in VS Code, and the bridge that shows the kedtec terminal CLI your open file and selection",
  "version": "0.2.1",
  "publisher": "kedtec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sovannDeveloper/kedtec-cli"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kedtec",
          "title": "KEDTec",
          "icon": "media/kedtec.svg"
        }
      ]
    },
    "views": {
      "kedtec": [
        {
          "type": "webview",
          "id": "kedtec.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "kedtec.newChat",
        "title": "New Chat",
        "category": "KEDTec",
        "icon": "$(add)"
      },
      {
        "command": "kedtec.history",
        "title": "Conversations…",
        "category": "KEDTec",
        "icon": "$(history)"
      },
      {
        "command": "kedtec.signIn",
        "title": "Sign In (Endpoint, API Key, Model)",
        "category": "KEDTec",
        "icon": "$(key)"
      },
      {
        "command": "kedtec.reload",
        "title": "Reload Configuration",
        "category": "KEDTec"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kedtec.newChat",
          "when": "view == kedtec.chat",
          "group": "navigation@1"
        },
        {
          "command": "kedtec.history",
          "when": "view == kedtec.chat",
          "group": "navigation@2"
        },
        {
          "command": "kedtec.signIn",
          "when": "view == kedtec.chat",
          "group": "more@1"
        },
        {
          "command": "kedtec.reload",
          "when": "view == kedtec.chat",
          "group": "more@2"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the chat ignores the project's KEDTEC.md / CLAUDE.md / AGENTS.md, .kedtec/settings.json and project memory."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "compile": "node build.js",
    "typecheck": "tsc -p .",
    "package": "node pack.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.6.0",
    "typescript": "5.9.3"
  }
}
