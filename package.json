{
  "name": "kedtec",
  "version": "0.1.8",
  "description": "KEDTec terminal coding agent: a Claude Code-style CLI for the KEDTec AI API and any OpenAI-compatible endpoint",
  "license": "MIT",
  "bin": {
    "kedtec": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "emit": "esbuild \"src/*.ts\" --outdir=dist --platform=node --format=cjs --target=node18 --minify --log-level=warning",
    "compile": "npm run typecheck && npm run emit",
    "watch": "npm run emit -- --watch",
    "start": "node dist/cli.js",
    "test": "npm run compile && node --test test/*.test.js",
    "bridge": "npm --prefix ide-bridge install && npm --prefix ide-bridge run package"
  },
  "dependencies": {
    "openai": "6.49.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
