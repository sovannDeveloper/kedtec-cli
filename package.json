{
  "name": "kedtec",
  "version": "0.1.0",
  "description": "KEDTec terminal coding agent: a Claude Code-style CLI for the KEDTec AI API and any OpenAI-compatible endpoint",
  "license": "MIT",
  "bin": {
    "kedtec": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "test": "tsc -p . && node --test test/*.test.js"
  },
  "dependencies": {
    "openai": "6.49.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
